# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=super_secret_privylens_jwt_signing_key_replace_in_production_2026
JWT_EXPIRES_IN=7d

# Groq API (Llama 3 / 3.3 models)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB Vector Database
CHROMA_URL=http://localhost:8000

# SMTP / Email Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@privylens.ai
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM="PrivyLens AI Intelligence" <alerts@privylens.ai>

# Client Application URL (For CORS & deep-linking)
CLIENT_URL=http://localhost:5173
